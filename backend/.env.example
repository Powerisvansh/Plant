# =============================================================================
# PlantDoctor server environment template
# =============================================================================
# Copy to `.env` and fill in real values.  NEVER commit the real `.env`.
#
#   cp .env.example .env
#   python -m app.cli generate-secrets      # writes strong random secrets
#
# On the desktop server the live file lives outside the repository at
#   /plantdoctor-data/.env   (mode 0600, owned by the app user)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development              # development | staging | production | test
DEBUG=false
PROJECT_NAME=PlantDoctor Server
VERSION=1.0.0
# Comma separated. Use explicit origins in production; "*" is refused there.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=*

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Preferred form. Use postgresql+psycopg (SQLAlchemy 2 + psycopg 3).
DATABASE_URL=postgresql+psycopg://plantdoctor:CHANGE_ME@127.0.0.1:5432/plantdoctor
TEST_DATABASE_URL=postgresql+psycopg://plantdoctor:CHANGE_ME@127.0.0.1:5432/plantdoctor_test

# Discrete form. Used by the legacy knowledge-base module and by the CLI tools.
PLANTDOCTOR_ENV_FILE=/plantdoctor-data/.env
PLANTDOCTOR_DB_HOST=127.0.0.1
PLANTDOCTOR_DB_PORT=5432
PLANTDOCTOR_DB_NAME=plantdoctor
PLANTDOCTOR_DB_TEST_NAME=plantdoctor_test
PLANTDOCTOR_DB_USER=plantdoctor
PLANTDOCTOR_DB_PASSWORD=CHANGE_ME
PLANTDOCTOR_DATA_ROOT=/plantdoctor-data

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY=1.0

# -----------------------------------------------------------------------------
# JWT  -- generate with: python -m app.cli generate-secrets
# -----------------------------------------------------------------------------
# Two different secrets: a leaked access-token key must not let an attacker
# mint refresh tokens. The server refuses to start if they are identical.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ISSUER=plantdoctor
AUDIENCE=plantdoctor-mobile

# -----------------------------------------------------------------------------
# Password hashing (Argon2id)
# -----------------------------------------------------------------------------
# Defaults: 64 MiB, 3 passes, 2 lanes. Raise memory cost on a 8 GiB+ host.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128

# -----------------------------------------------------------------------------
# OTP
# -----------------------------------------------------------------------------
OTP_HASH_PEPPER=               # generate with: python -m app.cli generate-secrets
OTP_LENGTH=6
OTP_TTL_SECONDS=300           # 5 minutes
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESENDS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# Email (SMTP) -- required for real OTP delivery
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PlantDoctor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
# Development fallback: when SMTP_HOST is empty, OTP emails are written as .eml
# files under this directory instead of being sent. Never enable in production.
MAILBOX_DIRECTORY=/plantdoctor-data/mail

# -----------------------------------------------------------------------------
# SMS (future; EmailOTPProvider is active today)
# -----------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=PLANTDOC

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Sub-directories created automatically: uploads/, plant-images/,
# diagnosis-images/, user-avatars/
UPLOAD_DIRECTORY=/plantdoctor-data/uploads
MAX_UPLOAD_BYTES=12582912       # 12 MiB
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=8000
MAX_IMAGE_PIXELS=40000000
IMAGE_RESPONSE_CACHE_SECONDS=3600

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DIRECTORY=/plantdoctor-data/backups
BACKUP_RETENTION_COUNT=14

# -----------------------------------------------------------------------------
# Rate limiting / brute force
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory       # memory | redis
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_UPLOAD_PER_HOUR=40
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional Redis. Leave empty on a single-process desktop server.
REDIS_URL=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text
# LOG_FILE=/plantdoctor-data/logs/app.log

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_LEGACY_KNOWLEDGE_ROUTES=true
SERVE_STATIC_UPLOADS=true
